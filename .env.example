# Скопируйте в .env и заполните. Файл .env не коммитится.

# --- Django ---
DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=visions-hw.kz,www.visions-hw.kz
CSRF_TRUSTED_ORIGINS=https://visions-hw.kz,https://www.visions-hw.kz

# --- HTTPS за reverse proxy (nginx должен передавать X-Forwarded-Proto) ---
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
# Включайте после проверки, что HTTPS работает на всех поддоменах; начните с 3600
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# IP клиента брать из X-Forwarded-For (только если перед приложением ваш nginx)
TRUST_X_FORWARDED_FOR=True

# --- Файлы ---
# True — Django сам отдаёт /static/ и аватары (если nginx не настроен на эти пути)
SERVE_FILES_WITH_DJANGO=False
# Префикс internal-location в nginx для приватных файлов (пусто — отдаёт Django)
PROTECTED_MEDIA_ACCEL_PREFIX=
TASK_UPLOAD_MAX_MB=20
PROFILE_IMAGE_MAX_MB=5
# CACHE_DIR=/var/tmp/visions-cache

# --- Почта (пароль приложения Gmail) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Кому приходят уведомления о сданных заданиях (через запятую)
TASK_NOTIFY_EMAILS=

# --- Защита от перебора паролей ---
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_LOCKOUT_SECONDS=900

# --- Бизнес-настройки ---
SOCIAL_POINTS_AUTO_AWARD=True
SESSION_TIMEOUT=5400
TELEGRAM_BOT_TOKEN=

# --- docker-compose (Postgres) ---
POSTGRES_DB=visions
POSTGRES_USER=
POSTGRES_PASSWORD=
